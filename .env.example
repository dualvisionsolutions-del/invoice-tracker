# ---- Required ----
# Password you use to log into the dashboard. Change this.
ADMIN_PASSWORD=changeme

# The public address of this app, used to build the links you text out.
# Example: https://jobs.dualvisionsolutions.com
PUBLIC_URL=http://localhost:3000

# ---- Optional ----
PORT=3000

# Keeps you logged in across restarts. Any long random string.
SESSION_SECRET=

# ---- Texting (optional) ----
# Leave blank and the app gives you a "Text this" button that opens your own
# phone's messaging app with the message pre-typed. Fill these in and the app
# sends the texts itself, and texts YOU when a job is finished.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15551234567

# Your cell. Gets a text when a crew member submits or a job goes overdue.
OWNER_PHONE=+15559876543

# ---- Notifications without Twilio (optional) ----
# Any URL that accepts a JSON POST. Point this at a Zapier / Make webhook to
# forward job events to text, email, Slack, a spreadsheet, whatever.
NOTIFY_WEBHOOK_URL=
